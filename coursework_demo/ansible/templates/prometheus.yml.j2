global:
  scrape_interval:     10s
  evaluation_interval: 10s
  external_labels:
    monitor: cw-tasktracker

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: node-exporter
    static_configs:
      - targets: ['{{ node_exporter_target }}']

  - job_name: tasktracker
    metrics_path: /metrics
    static_configs:
      - targets:
          - '{{ blue_target }}'
          - '{{ green_target }}'
        labels:
          app: tasktracker
