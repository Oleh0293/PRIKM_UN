{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "schemaVersion": 38,
  "tags": ["tasktracker", "coursework"],
  "title": "TaskTracker — SLO Dashboard",
  "timezone": "",
  "panels": [
    {
      "type": "stat",
      "title": "Requests / second",
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [
        {"expr": "sum(rate(tasktracker_requests_total[1m]))", "refId": "A"}
      ]
    },
    {
      "type": "stat",
      "title": "Error rate (5xx)",
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 0.05}
            ]
          }
        }
      },
      "targets": [
        {"expr": "sum(rate(tasktracker_requests_total{status=~\"5..\"}[5m])) / sum(rate(tasktracker_requests_total[5m]))", "refId": "A"}
      ]
    },
    {
      "type": "stat",
      "title": "Tasks total",
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [
        {"expr": "max(tasktracker_tasks_total)", "refId": "A"}
      ]
    },
    {
      "type": "stat",
      "title": "Active version (blue/green)",
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "options": {"textMode": "value_and_name"},
      "targets": [
        {"expr": "tasktracker_build_info", "refId": "A", "legendFormat": "{{version}}/{{color}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 latency by endpoint",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "id": 5,
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, endpoint) (rate(tasktracker_request_duration_seconds_bucket[5m])))", "refId": "A", "legendFormat": "{{endpoint}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests / s by endpoint",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "id": 6,
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "targets": [
        {"expr": "sum by (endpoint) (rate(tasktracker_requests_total[1m]))", "refId": "A", "legendFormat": "{{endpoint}}"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Host CPU usage (node_exporter)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "id": 7,
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {"defaults": {"unit": "percentunit"}},
      "targets": [
        {"expr": "1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m]))", "refId": "A", "legendFormat": "CPU busy"}
      ]
    },
    {
      "type": "timeseries",
      "title": "Host memory available",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "id": 8,
      "datasource": {"type": "prometheus", "uid": "PBFA97CFB590B2093"},
      "fieldConfig": {"defaults": {"unit": "bytes"}},
      "targets": [
        {"expr": "node_memory_MemAvailable_bytes", "refId": "A"}
      ]
    }
  ],
  "time": {"from": "now-30m", "to": "now"},
  "refresh": "10s"
}
