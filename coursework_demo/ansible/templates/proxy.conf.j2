upstream tasktracker_active {
    # Active slot is selected via Ansible variable (active_color={{ active_color }})
{% if active_color == "blue" %}
    server app-blue:5000;
{% else %}
    server app-green:5000;
{% endif %}
}

server {
    listen 80;
    server_name _;

    add_header X-CW-Active-Color "{{ active_color }}" always;

    location / {
        proxy_pass         http://tasktracker_active;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 10s;
    }
}
