pipeline {
    agent any

    environment {
        TF_IN_AUTOMATION    = 'true'
        ANSIBLE_HOST_KEY_CHECKING = 'False'
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Stage 1: Cloning repository...'
                checkout scm
            }
        }

        stage('Terraform Apply') {
            steps {
                echo 'Stage 2: Provisioning App Node infrastructure...'
                dir('lab8/terraform') {
                    sh 'terraform init -input=false'
                    sh 'terraform plan -out=tfplan -input=false'
                    sh 'terraform apply -auto-approve -input=false tfplan'
                }
            }
        }

        stage('Dynamic Inventory') {
            steps {
                echo 'Stage 3: Generating Ansible inventory from Terraform outputs...'
                dir('lab8/terraform') {
                    script {
                        env.NODE_EXPORTER_TARGET = sh(
                            script: 'terraform output -raw node_exporter_target',
                            returnStdout: true
                        ).trim()
                        env.APP_URL = sh(
                            script: 'terraform output -raw app_url',
                            returnStdout: true
                        ).trim()
                        env.NETWORK_NAME = sh(
                            script: 'terraform output -raw network_name',
                            returnStdout: true
                        ).trim()
                    }
                    sh 'terraform output -raw ansible_inventory > ../ansible/inventory.ini'
                }
                echo "App URL: ${env.APP_URL}"
                echo "Node Exporter target: ${env.NODE_EXPORTER_TARGET}"
                echo "Docker network: ${env.NETWORK_NAME}"
            }
        }

        stage('Ansible Deploy') {
            steps {
                echo 'Stage 4: Deploying monitoring stack via Ansible...'
                dir('lab8/ansible') {
                    sh """
                        ansible-playbook playbook.yml \
                            -i inventory.ini \
                            -e "node_exporter_target=${env.NODE_EXPORTER_TARGET}" \
                            -e "ansible_connection=local"
                    """
                }
            }
        }

        stage('Smoke Test') {
            steps {
                echo 'Stage 5: Running smoke tests...'
                sh 'sleep 5'
                script {
                    sh "curl -f ${env.APP_URL}"
                    echo 'App Node .... OK'

                    sh 'curl -sf http://localhost:9101/metrics | head -5'
                    echo 'Node Exporter .... OK'

                    sh 'curl -f http://localhost:9092/-/ready'
                    echo 'Prometheus .... OK'

                    sh 'curl -f http://localhost:3001/api/health'
                    echo 'Grafana .... OK'

                    echo 'All smoke tests passed!'
                }
            }
        }
    }

    post {
        failure {
            echo 'Pipeline FAILED — destroying infrastructure...'
            dir('lab8/terraform') {
                sh 'terraform destroy -auto-approve || true'
            }
        }
        success {
            echo 'Full CI/CD pipeline completed successfully!'
        }
        always {
            echo 'Pipeline finished.'
        }
    }
}
